<?xml version="1.0" encoding="utf-8" ?>
<root>
	<Display classname="ED::CDisplayEntityProps">
		<Class>GD::CDisplaySettler</Class>
		<Model>CU_Hermit_Shadow</Model>
		<DrawPlayerColor>True</DrawPlayerColor>
		<Anim>CU_Hermit_Walk</Anim>
        <Anim>CU_Hermit_Idle1</Anim>
		<Anim>CU_Hermit_Idle2</Anim>
		<Anim>CU_Hermit_Idle3</Anim>
		<Anim>CU_Hermit_Idle4</Anim>
		<Anim>CU_Hermit_Idle5</Anim>
		<Anim>CU_Hermit_Talk1</Anim>
		<Anim>CU_Hermit_Talk2</Anim>
	</Display>
	<Logic classname="GGL::CGLSettlerProps">
		<Class>GGL::CSettler</Class>
		<AccessCategory>AccessCategorySettler</AccessCategory>
		<MaxHealth> 50 </MaxHealth>
		<NeedsPlayer>true</NeedsPlayer>
		<ForceNoPlayer>false</ForceNoPlayer>
        <Hat></Hat>
		<AdjustWalkAnimSpeed>true</AdjustWalkAnimSpeed>
		<Exploration>0</Exploration>
		<IdleTaskList>TL_NPC_IDLE</IdleTaskList>
	</Logic>
	<Behavior>
		<Logic classname="GGL::CGLAnimationBehaviorExProps">
			<Class>GGL::CGLBehaviorAnimationEx</Class>
			<AnimSet>SET_CU_HERMIT</AnimSet>
		</Logic>
		<Display classname="ED::CBehaviorProps">
			<Class>ED::CDisplayBehaviorAnimation</Class>
		</Display>
	</Behavior>
	<Behavior>
		<Logic classname="EGL::CMovementBehaviorProps">
			<Class>GGL::CSettlerMovement</Class>
			<Speed>320</Speed>
			<RotationSpeed>15</RotationSpeed>
		<MoveTaskList>TL_NPC_WALK</MoveTaskList>
		<MoveIdleAnim>CU_Hermit_Idle1</MoveIdleAnim>
		</Logic>
		<Display classname="ED::CBehaviorProps">
			<Class>ED::CDisplayBehaviorMovement</Class>
		</Display>
	</Behavior>
	<Behavior>
		<Logic classname="EGL::CGLEBehaviorProps">
			<Class>GGL::CBehaviorWalkCommand</Class>
		</Logic>
	</Behavior>
	<Behavior>
	    <Logic classname="GGL::CCamouflageBehaviorProps">
	        <Class>GGL::CThiefCamouflageBehavior</Class>
	        <DurationSeconds>10</DurationSeconds>  <!-- Time between being discovered and returning to sneak mode -->
	        <DiscoveryRange>600.0</DiscoveryRange>
	    </Logic>
	    <Display classname="GD::CCamouflageBehaviorProps">
	        <Class>GD::CCamouflageBehavior</Class>
	        <CamouflageModelID>CU_Hermit_Shadow</CamouflageModelID>
	        <CamouflageAlpha>80</CamouflageAlpha>
	    </Display>
	</Behavior>

</root>
